{
	"name": "ticketbox",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev --port 5180 --strictPort",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "npm run i18n:compile && svelte-kit sync || echo ''",
		"check": "npm run i18n:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"db:up": "docker compose up -d --wait",
		"db:down": "docker compose down",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "tsx scripts/migrate.ts",
		"db:seed": "tsx scripts/seed.ts",
		"db:studio": "drizzle-kit studio",
		"test": "npm run test:integration && npm run test:e2e",
		"test:integration": "npm run i18n:compile && vitest run",
		"test:e2e": "playwright test",
		"i18n:compile": "paraglide-js compile --outdir ./src/lib/paraglide --strategy cookie preferredLanguage baseLocale",
		"user:superadmin": "tsx scripts/create-superadmin.ts"
	},
	"devDependencies": {
		"@inlang/paraglide-js": "^2.29.3",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.66.0",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-node": "^6.0.1",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.6",
		"@types/nodemailer": "^8.0.2",
		"bits-ui": "^2.20.3",
		"clsx": "^2.1.1",
		"drizzle-kit": "^0.31.11",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.15",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^5.0.5"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"better-auth": "^1.7.15",
		"drizzle-orm": "^0.45.4",
		"mode-watcher": "^1.1.0",
		"nodemailer": "^10.3.1",
		"postgres": "^4.0.0",
		"zod": "^4.6.7"
	}
}
